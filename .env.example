# Copy this file to ".env" and fill in your values, then start the server.
# The .env file is loaded automatically at startup (see app/__init__.py).
# NEVER commit the real .env — only this .example template.

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Any long random string; signs the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional locally. In production set to the deployed https callback, e.g.
# https://shelf-life.onrender.com/auth/callback
# OAUTH_REDIRECT_URI=

# Set to 1 in production so the session cookie is HTTPS-only.
# SESSION_HTTPS_ONLY=0
