# Copy this file to `.env` for local development. NEVER commit `.env`.
# In production, set these in the platform dashboard (Render -> Environment),
# not in the repository.

# CORS allowlist: comma-separated origins allowed to call the API from a browser.
# In production set this to your deployed origin, e.g. https://shelf-life.onrender.com
SHELF_LIFE_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Turso (cloud libSQL) ---------------------------------------------------
# Leave BOTH blank locally to use a local SQLite file instead. When
# TURSO_DATABASE_URL is set, the app talks to Turso and SHELF_LIFE_DB is ignored.
# Create a database and token with the Turso CLI:
#   turso db create shelf-life
#   turso db show shelf-life --url      # -> libsql://shelf-life-<you>.turso.io
#   turso db tokens create shelf-life   # -> the auth token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite path (ignored when TURSO_DATABASE_URL is set).
SHELF_LIFE_DB=shelf_life.db

# Lookup backend: mcp (default) | openlibrary (diagnostic) | seed (offline)
SHELF_LIFE_LOOKUP_BACKEND=mcp
